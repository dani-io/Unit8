# MT5 Bridge credentials — copy this to .env and fill in your values
# NEVER commit .env to git!

MT5_ACCOUNT=12345678
MT5_PASSWORD=your_password
MT5_SERVER=YourBroker-ECN

# Public hostname cloudflared routes to this bridge (reference only — the
# bridge itself listens on 127.0.0.1:8000). See CLOUDFLARE.md.
BRIDGE_URL=https://bridge.example.com

# Bearer token every request must carry. Required, 32+ chars — the bridge
# refuses to start without it. Use the same value in Unit8's .env. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
BRIDGE_TOKEN=change_me_generate_a_long_random_token

# Cloudflare Access service token — used by Unit8 (the client), not by the
# bridge. Listed here so both .env files stay in sync.
CF_ACCESS_CLIENT_ID=your_client_id.access
CF_ACCESS_CLIENT_SECRET=your_client_secret
