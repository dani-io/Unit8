# Unit8 credentials — copy this to .env and fill in your values
# NEVER commit .env to git!

# ─── MT5 (Windows only) ───
MT5_ACCOUNT=12345678
MT5_PASSWORD=your_password_here
MT5_SERVER=YourBroker-ECN

# ─── MT5 Bridge (Linux → Windows VM, see bridge/) ───
BRIDGE_URL=http://192.168.56.101:8000

# ─── cTrader Open API (Linux/Mac/Windows) ───
# Register your app at: https://openapi.ctrader.com
CTRADER_CLIENT_ID=your_app_client_id
CTRADER_CLIENT_SECRET=your_app_client_secret
CTRADER_ACCESS_TOKEN=your_oauth_access_token
CTRADER_ACCOUNT_ID=12345678
CTRADER_HOST_TYPE=demo
