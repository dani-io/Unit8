# Unit8 credentials — copy this to .env and fill in your values
# NEVER commit .env to git!

# ─── MT5 (Windows only) ───
MT5_ACCOUNT=12345678
MT5_PASSWORD=your_password_here
MT5_SERVER=YourBroker-ECN

# ─── MT5 Bridge (Linux → Windows VM via Cloudflare Tunnel, see bridge/CLOUDFLARE.md) ───
BRIDGE_URL=https://bridge.example.com
# Must match BRIDGE_TOKEN in bridge/.env (32+ chars). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
BRIDGE_TOKEN=change_me_generate_a_long_random_token
# Cloudflare Access service token (Zero Trust → Access → Service Auth)
CF_ACCESS_CLIENT_ID=your_client_id.access
CF_ACCESS_CLIENT_SECRET=your_client_secret

# ─── cTrader Open API (Linux/Mac/Windows) ───
# Register your app at: https://openapi.ctrader.com
CTRADER_CLIENT_ID=your_app_client_id
CTRADER_CLIENT_SECRET=your_app_client_secret
CTRADER_ACCESS_TOKEN=your_oauth_access_token
CTRADER_ACCOUNT_ID=12345678
CTRADER_HOST_TYPE=demo
